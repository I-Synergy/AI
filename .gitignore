# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Pytest
.pytest_cache/

# VS Code local overrides
.vscode/*.log

# Agent scratch folder
.ai/tmp/

# AI Workspace Manager extension state (generated locally; not template content)
.ai/ai.json
.ai/ai.lock.json
.ai/tooling.json
.ai/catalog/
.ai/installed/
.ai/scripts/catalog.py
.ai/**/.ai-installed.json

# Platform skill/agent junctions (recreated by sync-platforms.py)
.claude/skills/
.claude/agents/
.github/skills/
.github/agents/
.github/instructions/
.agents/skills/

# Retired adapter links, kept ignored so stale links never get committed
.github/prompts/
.claude/commands/
.claude/instructions/

# Claude Code rules generated from .ai/instructions/ (sync-platforms.py).
# Only the generated files are ignored; hand-written rules in .claude/rules/ are tracked.
.claude/rules/*.instructions.md

# AI Workspace Manager: resolver cache and platform junctions
.reasonix/skills/
.reasonix/agents/

# AI Workspace Manager: resolver cache and platform links
.github/hooks/
